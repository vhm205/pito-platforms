{
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "sh -c 'git diff --name-only --cached > .tmp-lint-staged-files'",
      "sh -c 'cd backend && yarn run lint'",
      "sh -c 'cd backend && yarn run format'",
      "sh -c 'git add $(cat .tmp-lint-staged-files) && rm .tmp-lint-staged-files'"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged"
  }
}
